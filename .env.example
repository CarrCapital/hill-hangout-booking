# Admin login for the /admin page
ADMIN_PASSWORD=change-me

# Neon Postgres (added automatically when you connect the Neon integration in
# the Vercel dashboard: Storage, Create, Postgres)
DATABASE_URL=

# Stripe (fill in once the account is live; the app runs without it until then)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend for transactional email (free tier is fine to start)
# Grab a key from https://resend.com; the free tier allows 3,000/month.
RESEND_API_KEY=
# Where host notifications land (new request, paid alerts).
NOTIFICATION_EMAIL=
# Sender address. Use the Resend sandbox until you verify a domain.
EMAIL_FROM="Hill Hangout <onboarding@resend.dev>"
